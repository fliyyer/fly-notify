<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/app-head', {
        title: 'Dashboard - FlyNotify',
        description: 'Dashboard FlyNotify untuk koneksi WhatsApp, API key, metrik, dan integrasi aplikasi client.'
    }) %>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        h1, h2, h3 { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-zinc-50/50 text-zinc-900 antialiased min-h-screen">
    <%- include('partials/auth-guard') %>
    <div class="flex min-h-screen overflow-hidden">
        <%- include('partials/sidebar') %>
        <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <!-- Header -->
            <header class="border-b border-zinc-200 bg-white px-6 py-5">
                <div class="flex items-center gap-3">
                    <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-950 hover:bg-zinc-50 lg:hidden" onclick="openSidebar()" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">Gateway Dashboard</h2>
                        <p class="text-xs text-zinc-500 mt-1">Satu panel FlyNotify untuk koneksi bot, API key, metrik, dan contoh integrasi.</p>
                    </div>
                </div>
            </header>

            <!-- Main Workspace -->
            <main class="flex-1 overflow-y-auto p-6">
                <!-- Stats Grid -->
                <section class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
                    <div class="card p-5">
                        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Total Sent</p>
                        <p id="statTotalSent" class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900">0</p>
                    </div>
                    <div class="card p-5">
                        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Sent Today</p>
                        <p id="statTodaySent" class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900">0</p>
                    </div>
                    <div class="card p-5">
                        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">API Keys</p>
                        <p id="statApiKeys" class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900">0</p>
                    </div>
                    <div class="card p-5">
                        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Templates</p>
                        <p id="statTemplates" class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900">0</p>
                    </div>
                </section>

                <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.15fr_0.85fr]">
                    <section class="space-y-6">
                        <!-- WhatsApp Accounts Card -->
                        <div class="card p-6">
                            <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
                                <div>
                                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Bot Runtime</p>
                                    <h3 class="mt-1 text-lg font-bold text-zinc-900">WhatsApp Accounts</h3>
                                </div>
                                <a href="/scan" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50">
                                    <i class="fas fa-cog mr-1.5 text-zinc-500"></i> Manage Devices
                                </a>
                            </div>
                            <div id="dashboardDevicesList" class="mt-6 space-y-4">
                                <div class="animate-pulse rounded-md bg-zinc-100 h-16 w-full"></div>
                            </div>
                        </div>

                        <!-- API Keys Generator Card -->
                        <div class="card p-6">
                            <div class="border-b border-zinc-100 pb-4">
                                <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Credentials</p>
                                <h3 class="mt-1 text-lg font-bold text-zinc-900">API Key Generator</h3>
                                <p class="text-xs text-zinc-500 mt-1">Generate key hanya dapat diakses saat minimal satu bot WhatsApp berstatus connected.</p>
                            </div>
                            
                            <form id="keyForm" class="mt-6 flex flex-col gap-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nama Integrasi / App</label>
                                        <input id="keyName" placeholder="Contoh: CS App, Billing Tenant" class="field">
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Tujuan Pengiriman</label>
                                        <select id="keyDeviceId" class="field">
                                            <option value="auto">Kirim lewat: Otomatis (First Ready)</option>
                                        </select>
                                    </div>
                                </div>
                                <button id="generateKeyBtn" type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90 self-start">
                                    Generate API Key
                                </button>
                            </form>
                            <div id="keyFeedback" class="hidden mt-4"></div>
                            <div id="keyList" class="mt-6 space-y-4"></div>
                        </div>
                    </section>

                    <!-- Sidebar Panel -->
                    <aside class="space-y-6">
                        <!-- Code Snippet -->
                        <div class="card p-6">
                            <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Endpoint push</p>
                            <h3 class="mt-1 text-base font-bold text-zinc-900">POST /api/push</h3>
                            <pre id="apiSnippet" class="mt-4 overflow-auto rounded-md bg-zinc-950 p-4 text-xs font-mono text-zinc-100 leading-relaxed">curl -X POST http://localhost:3000/api/push \
  -H "Content-Type: application/json" \
  -H "x-api-key: YOUR_KEY" \
  -d '{
    "to": "+14155550123",
    "recipientName": "Alya",
    "message": "Halo {name}, status terbaru sudah ready.",
    "variables": { "name": "Alya" }
  }'</pre>
                        </div>

                        <!-- History logs -->
                        <div class="card p-6">
                            <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-4">
                                <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-400">Activity</p>
                                <h3 class="text-xs font-bold text-zinc-500">Latest Delivery</h3>
                            </div>
                            <div id="recentHistory" class="space-y-3"></div>
                        </div>
                    </aside>
                </div>
            </main>
        </div>
    </div>

    <script>
        function logout() {
            localStorage.removeItem('wa_token');
            window.location.href = '/login';
        }

        document.querySelectorAll('.nav-link').forEach((link) => {
            if (link.href === window.location.href) link.classList.add('active');
        });

        async function loadStats() {
            const res = await fetch('/api/stats');
            const stats = await res.json();
            document.getElementById('statTotalSent').textContent = stats.totalSent || 0;
            document.getElementById('statTodaySent').textContent = stats.todaySent || 0;
            document.getElementById('statApiKeys').textContent = stats.apiKeyCount || 0;
            document.getElementById('statTemplates').textContent = stats.templateCount || 0;
        }

        let allDevices = [];

        async function loadDevices() {
            try {
                const res = await fetch('/api/devices');
                allDevices = await res.json();
                
                const select = document.getElementById('keyDeviceId');
                if (select) {
                    const currentVal = select.value;
                    select.innerHTML = '<option value="auto">Kirim lewat: Otomatis (First Ready)</option>';
                    allDevices.forEach(device => {
                        const statusText = device.status?.ready ? 'Connected' : 'Offline';
                        const option = document.createElement('option');
                        option.value = device.id;
                        option.textContent = `${device.name} (${device.phoneNumber ? '+' + maskPhoneNumber(device.phoneNumber) : 'Not connected'}) [${statusText}]`;
                        if (!device.status?.ready) {
                            option.textContent += ' ❌';
                            option.disabled = true;
                        } else {
                            option.textContent += ' ✅';
                        }
                        select.appendChild(option);
                    });
                    if (currentVal) select.value = currentVal;
                }
            } catch (e) {
                console.error('Failed to load devices:', e);
            }
        }

        async function loadBotStatus() {
            await loadDevices();
            const devices = allDevices;
            const container = document.getElementById('dashboardDevicesList');
            const keyButton = document.getElementById('generateKeyBtn');
            const keyName = document.getElementById('keyName');

            if (devices.length === 0) {
                container.innerHTML = `
                    <div class="rounded-md border border-zinc-200 bg-zinc-50 p-6 text-center">
                        <p class="text-sm font-medium text-zinc-600">Belum ada WhatsApp device terdaftar.</p>
                        <a href="/scan" class="mt-2 inline-flex text-xs font-bold text-zinc-900 underline hover:text-zinc-700">Tautkan WhatsApp pertama</a>
                    </div>
                `;
                if (keyButton) keyButton.disabled = true;
                if (keyName) keyName.disabled = true;
                loadKeys();
                return;
            }

            const hasReady = devices.some(d => d.status?.ready);
            if (keyButton) keyButton.disabled = !hasReady;
            if (keyName) keyName.disabled = !hasReady;

            container.innerHTML = devices.map(d => {
                const s = d.status || { ready: false, hasQR: false, qr: null, error: null };
                let statusBadge = '';
                let details = '';

                if (s.ready) {
                    statusBadge = '<span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700">CONNECTED</span>';
                    details = `<p class="mt-2 text-sm font-semibold text-zinc-800">${s.info?.name || 'WhatsApp Account'} (+${maskPhoneNumber(s.info?.number)})</p>`;
                } else if (s.hasQR && s.qr) {
                    statusBadge = '<span class="inline-flex items-center rounded-md border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 animate-pulse">SCAN QR NOW</span>';
                    details = `
                        <div class="mt-3 flex items-start gap-4">
                            <img src="${s.qr}" class="h-20 w-20 border border-zinc-200 bg-white p-1 rounded-md" alt="QR" />
                            <div class="text-xs text-zinc-500 leading-normal">
                                <p class="font-bold text-zinc-700">Scan QR Code ini</p>
                                <p>Buka WhatsApp > Perangkat tertaut > scan QR.</p>
                            </div>
                        </div>
                    `;
                } else if (s.error) {
                    statusBadge = '<span class="inline-flex items-center rounded-md border border-red-200 bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">ERROR</span>';
                    details = `<p class="mt-2 text-xs text-red-600 font-semibold">${s.error}</p>`;
                } else {
                    statusBadge = '<span class="inline-flex items-center rounded-md border border-zinc-200 bg-zinc-100 px-2 py-0.5 text-xs font-semibold text-zinc-700">INITIALIZING</span>';
                    details = '<p class="mt-2 text-xs text-zinc-500"><i class="fas fa-circle-notch fa-spin mr-1.5"></i> Menghubungkan ke Puppeteer...</p>';
                }

                return `
                    <div class="rounded-md border border-zinc-200 bg-zinc-50 p-4">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-sm text-zinc-900">${d.name}</span>
                            ${statusBadge}
                        </div>
                        ${details}
                    </div>
                `;
            }).join('');
            
            loadKeys();
        }

        async function loadKeys() {
            const res = await fetch('/api/keys');
            const keys = await res.json();
            const list = document.getElementById('keyList');
            if (keys.length === 0) {
                list.innerHTML = '<div class="rounded-md border border-zinc-200 bg-zinc-50 p-4 text-xs font-medium text-zinc-500">Belum ada API key aktif.</div>';
                return;
            }

            list.innerHTML = keys.map((item) => {
                const deviceName = item.deviceId === 'auto' || !item.deviceId
                    ? 'Otomatis (First Ready)'
                    : (allDevices.find(d => String(d.id) === String(item.deviceId))?.name || `Device ID: ${item.deviceId}`);
                return `
                    <div class="rounded-md border border-zinc-200 bg-zinc-50 p-4">
                        <div class="flex flex-col gap-3">
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-zinc-900">${item.name}</p>
                                <p class="mt-1 text-xs text-zinc-500">Device: <span class="text-zinc-700 font-semibold">${deviceName}</span></p>
                                <p class="mt-0.5 text-[10px] text-zinc-400 uppercase tracking-wider">Created: ${new Date(item.createdAt).toLocaleString('id-ID')}</p>
                                <p class="text-[10px] text-zinc-400 uppercase tracking-wider">Last used: ${item.lastUsedAt ? new Date(item.lastUsedAt).toLocaleString('id-ID') : 'never'}</p>
                                <code class="mt-3 block overflow-auto rounded-md bg-zinc-950 p-3 text-xs font-mono text-zinc-100">${item.key}</code>
                            </div>
                            <div class="flex flex-wrap gap-2 pt-2 border-t border-zinc-200/60 justify-end">
                                <button onclick="copyKey('${item.key}')" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50">
                                    <i class="fas fa-copy mr-1 text-zinc-400"></i> Copy
                                </button>
                                <button onclick="copyExpressExample('${item.key}', '${item.name.replace(/'/g, "\\'")}')" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50">
                                    Node.js Sample
                                </button>
                                <button onclick="deleteKey(${item.id})" class="inline-flex h-8 items-center justify-center rounded-md border border-red-200 bg-red-50 px-3 text-xs font-medium text-red-700 transition-colors hover:bg-red-100">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function maskPhoneNumber(phone) {
            const str = String(phone || '').trim();
            if (!str || str === '-') return '-';
            if (str.length <= 8) return str;
            const front = str.slice(0, 4);
            const back = str.slice(-4);
            const middleLength = str.length - 8;
            const stars = '*'.repeat(middleLength > 0 ? middleLength : 4);
            return `${front}${stars}${back}`;
        }

        async function loadHistory() {
            const res = await fetch('/api/notifications');
            const items = await res.json();
            const container = document.getElementById('recentHistory');
            if (items.length === 0) {
                container.innerHTML = '<div class="rounded-md border border-zinc-200 bg-zinc-50 p-4 text-xs font-medium text-zinc-500">Belum ada riwayat push.</div>';
                return;
            }

            container.innerHTML = items.slice(0, 4).map((item) => `
                <div class="rounded-md border border-zinc-200 bg-zinc-50 p-3 text-xs leading-normal">
                    <p class="font-bold text-zinc-900">${item.recipientName || item.bookingName || 'Unknown'}</p>
                    <p class="text-zinc-500">${maskPhoneNumber(item.phone)}</p>
                    <p class="mt-1 text-[10px] text-zinc-400 font-medium uppercase tracking-wider">${item.appName || item.source || 'manual'} • ${new Date(item.sentAt).toLocaleString('id-ID')}${item.senderDevice ? ` • via ${item.senderDevice}` : ''}</p>
                </div>
            `).join('');
        }

        async function logoutBot() {
            await fetch('/api/bot/logout', { method: 'POST' });
            setTimeout(loadBotStatus, 1500);
        }

        async function deleteKey(id) {
            await fetch('/api/keys/' + id, { method: 'DELETE' });
            loadKeys();
            loadStats();
        }

        async function copyKey(key) {
            await navigator.clipboard.writeText(key);
        }

        async function copyExpressExample(key, appName) {
            const example = `const express = require('express');
const fetch = global.fetch;

const app = express();
app.use(express.json());

app.post('/send-whatsapp', async (req, res) => {
  const response = await fetch('${window.location.origin}/api/push', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': '${key}'
    },
    body: JSON.stringify({
      to: req.body.to,
      recipientName: req.body.recipientName,
      message: req.body.message,
      variables: req.body.variables || {}
    })
  });

  const result = await response.json();
  res.status(response.status).json(result);
});

app.listen(4000, () => {
  console.log('Client app ready for ${appName}');
});`;
            await navigator.clipboard.writeText(example);
        }

        document.getElementById('keyForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const name = document.getElementById('keyName').value.trim();
            const deviceId = document.getElementById('keyDeviceId').value;
            const feedback = document.getElementById('keyFeedback');
            const res = await fetch('/api/keys', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, deviceId })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('keyName').value = '';
                feedback.className = 'mt-4 rounded-md border border-emerald-200 bg-emerald-50/50 p-3 text-xs font-semibold text-emerald-700';
                feedback.textContent = 'API key berhasil dibuat dan siap dipakai oleh Express client.';
                feedback.classList.remove('hidden');
                loadKeys();
                loadStats();
            } else {
                feedback.className = 'mt-4 rounded-md border border-red-200 bg-red-50/50 p-3 text-xs font-semibold text-red-700';
                feedback.textContent = data.error || 'Gagal generate API key.';
                feedback.classList.remove('hidden');
            }
        });

        const socket = io();
        socket.on('qr', loadBotStatus);
        socket.on('ready', loadBotStatus);
        socket.on('status', loadBotStatus);
        socket.on('device_status', loadBotStatus);
        socket.on('devices_status', loadBotStatus);

        // Update API snippet to use the current host origin dynamically
        const snippetEl = document.getElementById('apiSnippet');
        if (snippetEl) {
            snippetEl.textContent = `curl -X POST ${window.location.origin}/api/push \\
  -H "Content-Type: application/json" \\
  -H "x-api-key: YOUR_KEY" \\
  -d '{
    "to": "+14155550123",
    "recipientName": "Alya",
    "message": "Halo {name}, status terbaru sudah ready.",
    "variables": { "name": "Alya" }
  }'`;
        }

        loadStats();
        loadBotStatus();
        loadHistory();
    </script>
    <%- include('partials/app-shell-script') %>
</body>
</html>