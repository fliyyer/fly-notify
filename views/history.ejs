<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/app-head', {
        title: 'History - FlyNotify',
        description: 'Lihat riwayat pengiriman pesan WhatsApp dari dashboard dan endpoint API FlyNotify.'
    }) %>
    <style>
        h1, h2, h3 { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-zinc-50/50 text-zinc-900 antialiased min-h-screen">
    <%- include('partials/auth-guard') %>
    <div class="flex min-h-screen overflow-hidden">
        <%- include('partials/sidebar') %>
        <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <!-- Header -->
            <header class="border-b border-zinc-200 bg-white px-6 py-5">
                <div class="flex items-center gap-3">
                    <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-950 hover:bg-zinc-50 lg:hidden" onclick="openSidebar()" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">Delivery History</h2>
                        <p class="text-xs text-zinc-500 mt-1">Riwayat semua push yang dikirim dari dashboard maupun endpoint API.</p>
                    </div>
                </div>
            </header>
            
            <main class="flex-1 overflow-y-auto p-6">
                <section class="card p-6">
                    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-zinc-100 pb-4">
                        <div>
                            <h3 class="text-base font-bold text-zinc-900">Push Log</h3>
                            <p class="text-xs text-zinc-500 mt-1">Diurutkan berdasarkan yang terbaru.</p>
                        </div>
                        <button onclick="loadNotifications()" class="inline-flex h-9 items-center justify-center rounded-md border border-zinc-200 bg-white px-4 text-sm font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50">
                            <i class="fas fa-rotate mr-1.5 text-zinc-450"></i> Refresh
                        </button>
                    </div>
                    <div id="historyList" class="space-y-4"></div>
                    
                    <!-- Pagination Controls -->
                    <div id="paginationControls" class="mt-6 flex items-center justify-between border-t border-zinc-150 pt-4 hidden">
                        <div class="text-xs text-zinc-500">
                            Menampilkan <span id="pagStart" class="font-semibold">0</span> sampai <span id="pagEnd" class="font-semibold">0</span> dari <span id="pagTotal" class="font-semibold">0</span> item
                        </div>
                        <div class="flex items-center gap-2">
                            <button id="btnPrev" onclick="changePage(-1)" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50 disabled:opacity-50 disabled:pointer-events-none">
                                Previous
                            </button>
                            <button id="btnNext" onclick="changePage(1)" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50 disabled:opacity-50 disabled:pointer-events-none">
                                Next
                            </button>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script>
        function logout() {
            localStorage.removeItem('wa_token');
            window.location.href = '/login';
        }
        document.querySelectorAll('.nav-link').forEach((link) => {
            if (link.href === window.location.href) link.classList.add('active');
        });
        function maskPhoneNumber(phone) {
            const str = String(phone || '').trim();
            if (!str || str === '-') return '-';
            if (str.length <= 8) return str;
            const front = str.slice(0, 4);
            const back = str.slice(-4);
            const middleLength = str.length - 8;
            const stars = '*'.repeat(middleLength > 0 ? middleLength : 4);
            return `${front}${stars}${back}`;
        }

        let allNotifications = [];
        let currentPage = 1;
        const pageSize = 10;

        async function loadNotifications() {
            const res = await fetch('/api/notifications');
            allNotifications = await res.json();
            currentPage = 1;
            renderPage();
        }

        function renderPage() {
            const container = document.getElementById('historyList');
            const total = allNotifications.length;

            if (total === 0) {
                container.innerHTML = '<div class="rounded-md border border-zinc-200 bg-zinc-50 p-4 text-xs font-medium text-zinc-500">Belum ada log push.</div>';
                document.getElementById('paginationControls').classList.add('hidden');
                return;
            }

            const totalPages = Math.ceil(total / pageSize);
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = Math.min(startIdx + pageSize, total);
            const paginatedItems = allNotifications.slice(startIdx, endIdx);

            container.innerHTML = paginatedItems.map((item, index) => {
                const message = item.message || '';
                const lineCount = message.split('\n').length;
                const isLong = message.length > 120 || lineCount > 2;

                return `
                    <div class="rounded-lg border border-zinc-200 bg-white p-5 shadow-sm">
                        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="text-sm font-bold text-zinc-900">${item.recipientName || item.bookingName || 'Unknown recipient'}</p>
                                    <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 uppercase tracking-wide">${item.status || 'sent'}</span>
                                </div>
                                <p class="text-xs text-zinc-500 mt-1">${maskPhoneNumber(item.phone)}</p>
                                <p class="mt-1.5 text-[10px] font-medium uppercase tracking-wider text-zinc-400">${item.appName || item.source || 'manual'} • ${new Date(item.sentAt).toLocaleString('id-ID')}${item.senderDevice ? ` • via ${item.senderDevice}` : ''}</p>
                            </div>
                        </div>
                        <div class="relative mt-4">
                            <pre id="msg-pre-${index}" class="whitespace-pre-wrap text-xs text-zinc-650 font-mono bg-zinc-50 border border-zinc-150 p-3 rounded-md leading-relaxed transition-all duration-200 ${isLong ? 'line-clamp-2' : ''}">${message || '-'}</pre>
                            ${isLong ? `
                            <div class="mt-2 flex justify-end">
                                <button id="msg-btn-${index}" onclick="toggleMessage(${index})" class="inline-flex items-center gap-1.5 rounded bg-zinc-100 px-2.5 py-1 text-[11px] font-semibold text-zinc-600 hover:bg-zinc-200 transition-colors">
                                    <span>Lihat Selengkapnya</span>
                                    <i class="fas fa-chevron-down text-[9px] transition-transform duration-200"></i>
                                </button>
                            </div>
                            ` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            // Update Pagination UI
            document.getElementById('paginationControls').classList.remove('hidden');
            document.getElementById('pagStart').textContent = startIdx + 1;
            document.getElementById('pagEnd').textContent = endIdx;
            document.getElementById('pagTotal').textContent = total;

            document.getElementById('btnPrev').disabled = currentPage === 1;
            document.getElementById('btnNext').disabled = currentPage === totalPages;
        }

        function changePage(direction) {
            currentPage += direction;
            renderPage();
        }

        function toggleMessage(index) {
            const pre = document.getElementById(`msg-pre-${index}`);
            const btn = document.getElementById(`msg-btn-${index}`);
            const text = btn.querySelector('span');
            const icon = btn.querySelector('i');
            
            const isCollapsed = pre.classList.contains('line-clamp-2');
            if (isCollapsed) {
                pre.classList.remove('line-clamp-2');
                text.textContent = 'Sembunyikan';
                icon.classList.add('rotate-180');
            } else {
                pre.classList.add('line-clamp-2');
                text.textContent = 'Lihat Selengkapnya';
                icon.classList.remove('rotate-180');
            }
        }

        loadNotifications();
    </script>
    <%- include('partials/app-shell-script') %>
</body>
</html>
