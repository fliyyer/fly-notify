<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/app-head', {
        title: 'Send Message - FlyNotify',
        description: 'Kirim dan tes pesan WhatsApp manual dari FlyNotify dengan payload yang bebas dikustom.'
    }) %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #f8f7f4; color: #1c1917; }
        h1, h2, h3 { font-family: 'Inter', sans-serif; }
        .nav-link.active { background: #1f2937; color: white; }
        .nav-link.active i { color: #cbd5e1 !important; }
        .card { background: white; border: 1px solid #e4e4e7; border-radius: 0.5rem; }
        .field { width: 100%; border: 1px solid #e4e4e7; border-radius: 0.375rem; background: white; padding: 0.5rem 0.75rem; outline: none; transition: border-color .15s, box-shadow .15s; font-size: 0.875rem; }
        .field:focus { border-color: #a1a1aa; box-shadow: 0 0 0 1px #a1a1aa; }
        .field.is-error { border-color: #ef4444; box-shadow: 0 0 0 1px #ef4444; }
        .field-error-msg { color: #ef4444; font-size: 0.75rem; margin-top: 0.35rem; display: none; }
        .field-error-msg.show { display: block; }

        /* Mode tabs */
        .mode-tab { flex: 1; padding: 0.375rem 0.75rem; border-radius: 0.375rem; font-weight: 500; font-size: 0.75rem; transition: all 0.15s; cursor: pointer; text-align: center; border: none; background: transparent; color: #71717a; }
        .mode-tab.active { background: #ffffff; color: #09090b; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
        .mode-tab:hover:not(.active) { color: #09090b; }

        /* Result items */
        .result-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.75rem; border: 1px solid transparent; }
        .result-item.ok { background: #f0fdf4; color: #166534; border-color: #bbf7d0; }
        .result-item.fail { background: #fef2f2; color: #991b1b; border-color: #fecaca; }

        /* Spinner */
        @keyframes spin { to { transform: rotate(360deg); } }
        .spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.4); border-top-color: white; border-radius: 50%; animation: spin .7s linear infinite; display: inline-block; vertical-align: middle; margin-right: 6px; }
    </style>
</head>
<body class="bg-zinc-50/50 text-zinc-900 antialiased min-h-screen">
    <%- include('partials/auth-guard') %>
    <div class="flex min-h-screen overflow-hidden">
        <%- include('partials/sidebar') %>
        <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <header class="border-b border-zinc-200 bg-white px-6 py-5">
                <div class="flex items-center gap-3">
                    <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-950 hover:bg-zinc-50 lg:hidden" onclick="openSidebar()" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">Send Message</h2>
                        <p class="text-xs text-zinc-500 mt-1">Kirim pesan WhatsApp manual — custom message atau pakai template, bebas.</p>
                    </div>
                </div>
            </header>
            <main class="flex-1 overflow-y-auto p-6">
                <div class="grid grid-cols-1 gap-6 xl:grid-cols-[1.05fr_0.95fr]">
                    <section class="card p-6">
                        <h3 class="text-base font-bold text-zinc-900">Kirim Pesan</h3>
                        <p class="mt-1 text-zinc-500 text-xs">Nomor tujuan wajib diisi. Isi pesan bisa langsung diketik atau pilih template sebagai titik awal.</p>

                        <div class="mt-4 flex gap-1 rounded-md bg-zinc-100 p-1">
                            <button type="button" id="modeCustom" class="mode-tab active" onclick="setMode('custom')">
                                <i class="fas fa-pencil-alt mr-1.5"></i> Tulis Langsung
                            </button>
                            <button type="button" id="modeTpl" class="mode-tab" onclick="setMode('template')">
                                <i class="fas fa-file-alt mr-1.5"></i> Dari Template
                            </button>
                        </div>

                        <form id="pushForm" class="mt-6 space-y-4" novalidate>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Kirim Dari Device <span class="text-red-500">*</span></label>
                                <select id="deviceId" class="field">
                                    <option value="auto">Otomatis (First Ready)</option>
                                </select>
                            </div>

                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nomor Tujuan <span class="text-red-500">*</span></label>
                                <textarea id="numbers" rows="3" placeholder="Satu atau banyak nomor. Pisahkan dengan enter atau koma.&#10;Contoh: 628123456789, 628987654321" class="field"></textarea>
                                <p id="errNumbers" class="field-error-msg">Masukkan minimal satu nomor tujuan.</p>
                            </div>

                            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nama Penerima <span class="text-zinc-400 font-normal">(opsional)</span></label>
                                    <input id="recipientName" placeholder="Untuk placeholder {name}" class="field">
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nama App / Source <span class="text-zinc-400 font-normal">(opsional)</span></label>
                                    <input id="appName" placeholder="Mis. Billing Service" class="field">
                                </div>
                            </div>

                            <div id="templateSection" class="hidden flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Pilih Template <span class="text-zinc-400 font-normal">(opsional)</span></label>
                                <select id="templateId" class="field">
                                    <option value="">— Pilih template —</option>
                                </select>
                            </div>

                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Isi Pesan <span class="text-red-500">*</span></label>
                                <textarea id="customMessage" rows="7" placeholder="Tulis pesan kamu di sini." class="field"></textarea>
                                <p id="errMessage" class="field-error-msg">Isi pesan tidak boleh kosong.</p>
                            </div>

                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Variables JSON <span class="text-zinc-400 font-normal">(opsional)</span></label>
                                <textarea id="variables" rows="2" placeholder='{"key":"value"}' class="field font-mono text-xs"></textarea>
                                <p id="errVars" class="field-error-msg"></p>
                            </div>

                            <button type="submit" id="submitBtn" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90 w-full sm:w-auto">
                                <i class="fas fa-paper-plane mr-2 text-zinc-300"></i> Kirim Sekarang
                            </button>
                        </form>
                    </section>

                    <aside class="space-y-6">
                        <div class="card p-6">
                            <h3 class="text-base font-bold text-zinc-900 border-b border-zinc-100 pb-3 mb-4">Hasil Pengiriman</h3>
                            <div id="sendSummary" class="min-h-[60px] rounded-md bg-zinc-50 border border-zinc-200 p-4 text-xs text-zinc-500 flex items-center justify-center text-center leading-normal">
                                Belum ada pengiriman.
                            </div>
                            <div id="sendDetails" class="mt-4 space-y-2 hidden"></div>
                        </div>

                       <div class="card p-6">
                            <h3 class="text-base font-bold text-zinc-900 border-b border-zinc-100 pb-3 mb-4">Panduan</h3>
                            <ul class="space-y-3 text-xs leading-relaxed text-zinc-500 list-none">
                                <li class="flex gap-2.5 items-start">
                                    <span class="flex-none w-5 h-5 rounded bg-zinc-100 border border-zinc-200 flex items-center justify-center text-[10px] font-bold text-zinc-700">1</span>
                                    <span>Isi nomor tujuan — pisahkan dengan enter atau koma.</span>
                                </li>
                                <li class="flex gap-2.5 items-start">
                                    <span class="flex-none w-5 h-5 rounded bg-zinc-100 border border-zinc-200 flex items-center justify-center text-[10px] font-bold text-zinc-700">2</span>
                                    <span>Pilih <strong>Tulis Langsung</strong> untuk pesan manual atau <strong>Dari Template</strong> untuk pakai template.</span>
                                </li>
                                <li class="flex gap-2.5 items-start">
                                    <span class="flex-none w-5 h-5 rounded bg-zinc-100 border border-zinc-200 flex items-center justify-center text-[10px] font-bold text-zinc-700">3</span>
                                    <span>Gunakan <code class="bg-zinc-100 px-1 py-0.5 rounded text-[11px] font-mono text-zinc-800">{key}</code> dalam pesan dan isi melalui Variables JSON.</span>
                                </li>
                            </ul>
                        </div>
                    </aside>
                </div>
            </main>
        </div>
    </div>

    <script>
        let templates = [];
        let currentMode = 'custom';

        function setMode(mode) {
            currentMode = mode;
            document.getElementById('modeCustom').classList.toggle('active', mode === 'custom');
            document.getElementById('modeTpl').classList.toggle('active', mode === 'template');
            document.getElementById('templateSection').classList.toggle('hidden', mode === 'custom');
        }

        async function loadTemplates() {
            try {
                const res = await fetch('/api/templates');
                templates = await res.json();
                const select = document.getElementById('templateId');
                select.innerHTML = '<option value="">— Pilih template —</option>' +
                    templates.map((item) => `<option value="${item.id}">${item.name}</option>`).join('');
            } catch (e) {}
        }

        document.getElementById('templateId').addEventListener('change', () => {
            const val = document.getElementById('templateId').value;
            const selected = templates.find((item) => String(item.id) === val);
            if (selected) {
                document.getElementById('customMessage').value = selected.message;
            }
        });

        function setFieldError(fieldId, errId, show) {
            const field = document.getElementById(fieldId);
            const err   = document.getElementById(errId);
            if (show) {
                field.classList.add('is-error');
                err.classList.add('show');
            } else {
                field.classList.remove('is-error');
                err.classList.remove('show');
            }
        }

        function setSummary(type, html) {
            const s = document.getElementById('sendSummary');
            const colorMap = {
                idle:    'bg-zinc-50 text-zinc-500 border-zinc-200',
                loading: 'bg-zinc-50 text-zinc-700 border-zinc-200',
                success: 'bg-emerald-50 text-emerald-800 border-emerald-200/50',
                warning: 'bg-amber-50 text-amber-800 border-amber-200/50',
                error:   'bg-red-50 text-red-750 border-red-200/50'
            };
            s.className = `min-h-[60px] rounded-md border p-4 text-xs leading-normal flex items-center justify-center text-center ${colorMap[type] || colorMap.idle}`;
            s.innerHTML = html;
        }


        document.getElementById('pushForm').addEventListener('submit', async (event) => {
            event.preventDefault();

            // --- Validate ---
            let valid = true;
            const numbersVal = document.getElementById('numbers').value.trim();
            const messageVal = document.getElementById('customMessage').value.trim();
            const varsRaw    = document.getElementById('variables').value.trim();

            setFieldError('numbers', 'errNumbers', !numbersVal);
            if (!numbersVal) valid = false;

            setFieldError('customMessage', 'errMessage', !messageVal);
            if (!messageVal) valid = false;

            let variables = {};
            if (varsRaw) {
                try {
                    variables = JSON.parse(varsRaw);
                    setFieldError('variables', 'errVars', false);
                } catch (e) {
                    document.getElementById('errVars').textContent = 'JSON tidak valid: ' + e.message;
                    setFieldError('variables', 'errVars', true);
                    valid = false;
                }
            }

            if (!valid) return;

            // --- Submit ---
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Mengirim…';
            setSummary('loading', '<i class="fas fa-circle-notch fa-spin mr-2"></i> Mengirim pesan…');
            document.getElementById('sendDetails').classList.add('hidden');
            document.getElementById('sendDetails').innerHTML = '';

            const payload = {
                appName:       document.getElementById('appName').value.trim(),
                name:          document.getElementById('recipientName').value.trim(),
                numbers:       document.getElementById('numbers').value,
                templateId:    (currentMode === 'template' && document.getElementById('templateId').value) ? document.getElementById('templateId').value : null,
                customMessage: document.getElementById('customMessage').value,
                variables,
                deviceId:      document.getElementById('deviceId').value
            };

            try {
                const res  = await fetch('/api/send', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(payload)
                });
                const data = await res.json();

                if (!data.success) {
                    setSummary('error', '<i class="fas fa-times-circle mr-2"></i>' + (data.error || 'Push gagal.'));
                } else {
                    const failed = data.results.filter((r) => !r.success);
                    const allOk  = failed.length === 0;

                    if (allOk) {
                        setSummary('success', `<i class="fas fa-check-circle mr-2"></i> Semua terkirim! <strong>${data.totalSent}/${data.total}</strong> pesan berhasil.`);
                    } else {
                        setSummary('warning', `<i class="fas fa-exclamation-triangle mr-2"></i> Terkirim <strong>${data.totalSent}/${data.total}</strong>. ${failed.length} gagal.`);
                    }

                    // Detail per nomor
                    if (data.results.length > 0) {
                        const details = document.getElementById('sendDetails');
                        details.classList.remove('hidden');
                        details.innerHTML = data.results.map((r) =>
                            `<div class="result-item ${r.success ? 'ok' : 'fail'}">
                                <i class="fas ${r.success ? 'fa-check' : 'fa-times'} fa-xs flex-none"></i>
                                <span class="font-mono font-medium">${maskPhoneNumber(r.phone)}</span>
                                ${!r.success ? `<span class="ml-auto text-xs opacity-70">${r.error || 'Gagal'}</span>` : ''}
                            </div>`
                        ).join('');
                    }
                }
            } catch (e) {
                setSummary('error', '<i class="fas fa-wifi mr-2"></i> Koneksi gagal: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i> Kirim Sekarang';
            }
        });

        // Clear error on input
        ['numbers', 'customMessage'].forEach((id) => {
            document.getElementById(id).addEventListener('input', () => {
                if (document.getElementById(id).value.trim()) {
                    document.getElementById(id).classList.remove('is-error');
                }
            });
        });

        async function loadDevices() {
            try {
                const res = await fetch('/api/devices');
                const devices = await res.json();
                const select = document.getElementById('deviceId');
                
                select.innerHTML = '<option value="auto">Otomatis (First Ready)</option>';
                
                devices.forEach(device => {
                    const statusText = device.status?.ready ? 'Connected' : 'Offline/Not Connected';
                    const option = document.createElement('option');
                    option.value = device.id;
                    option.textContent = `${device.name} (${device.phoneNumber ? '+' + maskPhoneNumber(device.phoneNumber) : 'Not connected'}) [${statusText}]`;
                    if (!device.status?.ready) {
                        option.textContent += ' ❌';
                        option.disabled = true;
                    } else {
                        option.textContent += ' ✅';
                    }
                    select.appendChild(option);
                });
            } catch (e) {
                console.error('Failed to load devices:', e);
            }
        }

        function maskPhoneNumber(phone) {
            const str = String(phone || '').trim();
            if (!str || str === '-') return '-';
            if (str.length <= 8) return str;
            const front = str.slice(0, 4);
            const back = str.slice(-4);
            const middleLength = str.length - 8;
            const stars = '*'.repeat(middleLength > 0 ? middleLength : 4);
            return `${front}${stars}${back}`;
        }

        loadTemplates();
        loadDevices();
    </script>
    <%- include('partials/app-shell-script') %>
</body>
</html>
