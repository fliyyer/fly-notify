<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'FlyNotify adalah gateway WhatsApp untuk push notification, API key management, dan monitoring pengiriman.' %>">
<meta name="theme-color" content="#ffffff">
<meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' ? title : 'FlyNotify') %>">
<meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : (typeof description !== 'undefined' ? description : 'Gateway WhatsApp untuk mengirim push notification dari aplikasi kamu.') %>">
<meta property="og:type" content="website">
<meta property="og:image" content="/icons/flynotify-icon.svg">
<meta property="og:site_name" content="FlyNotify">
<title><%= typeof title !== 'undefined' ? title : 'FlyNotify' %></title>
<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg">
<link rel="apple-touch-icon" href="/icons/flynotify-icon.svg">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                },
                borderRadius: {
                    lg: '0.5rem',     // 8px (shadcn standard)
                    md: 'calc(0.5rem - 2px)', // 6px
                    sm: 'calc(0.5rem - 4px)', // 4px
                }
            }
        }
    }
</script>
<style>
    * { font-family: 'Inter', sans-serif; }
    body { background: #fafafa; color: #09090b; }
    
    /* Shadcn Card */
    .card, .surface {
        background: #ffffff;
        border: 1px solid #e4e4e7;
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
    
    /* Shadcn Button variants */
    .btn-soft {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        font-weight: 500;
        font-size: 0.875rem;
        line-height: 1.25rem;
        padding: 0.5rem 1rem;
        transition: all 0.15s ease-in-out;
        cursor: pointer;
        outline: none;
    }
    .btn-soft:hover {
        transform: none;
    }
    
    /* Shadcn Input fields */
    .field {
        display: flex;
        width: 100%;
        border-radius: 0.375rem;
        border: 1px solid #e4e4e7;
        background-color: #ffffff;
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: #09090b;
        outline: none;
        transition: all 0.15s ease-in-out;
    }
    input.field, select.field {
        height: 2.25rem;
    }
    .field:focus {
        border-color: #09090b;
        box-shadow: 0 0 0 1px #09090b;
    }

    
    /* Sidebar Navigation Links */
    .nav-link {
        display: flex;
        align-items: center;
        border-radius: 0.375rem;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: #71717a;
        transition: all 0.15s ease-in-out;
    }
    .nav-link:hover {
        background-color: #f4f4f5;
        color: #09090b;
    }
    .nav-link.active {
        background-color: #f4f4f5;
        color: #09090b;
        font-weight: 600;
    }
    .nav-link.active i {
        color: #09090b !important;
    }

    /* Scrollbars styling */
    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    ::-webkit-scrollbar-track {
        background: transparent;
    }
    ::-webkit-scrollbar-thumb {
        background: #e4e4e7;
        border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #d4d4d8;
    }
</style>

