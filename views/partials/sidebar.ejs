<div
  id="sidebarOverlay"
  class="fixed inset-0 z-40 hidden bg-zinc-950/20 lg:hidden backdrop-blur-sm"
  onclick="closeSidebar()"
></div>
<aside
  id="appSidebar"
  class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-zinc-200 bg-white transition-transform duration-200 ease-out lg:static lg:translate-x-0 lg:flex-shrink-0"
>
  <div
    class="flex items-center justify-between border-b border-zinc-200 px-6 py-5"
  >
    <div class="flex items-center gap-3">
      <img
        src="/icons/flynotify-icon.svg"
        alt="FlyNotify"
        class="h-9 w-9 rounded-md border border-zinc-200"
      />
      <div>
        <h1 class="font-bold text-sm text-zinc-900 leading-none">FlyNotify</h1>
        <p class="text-[10px] font-medium uppercase tracking-[0.15em] text-zinc-500 mt-1">
          Gateway Console
        </p>
      </div>
    </div>
    <button
      type="button"
      class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-900 hover:bg-zinc-50 lg:hidden"
      onclick="closeSidebar()"
      aria-label="Close menu"
    >
      <i class="fas fa-times text-sm"></i>
    </button>
  </div>
  <nav class="flex-1 space-y-1 overflow-y-auto p-4">
    <a
      href="/dashboard"
      class="nav-link"
    >
      <i class="fas fa-bolt mr-2.5 text-zinc-400 w-4 text-center"></i>Dashboard
    </a>
    <a
      href="/send"
      class="nav-link"
    >
      <i class="fas fa-paper-plane mr-2.5 text-zinc-400 w-4 text-center"></i>Send Message
    </a>
    <a
      href="/templates"
      class="nav-link"
    >
      <i class="fas fa-file-alt mr-2.5 text-zinc-400 w-4 text-center"></i>Templates
    </a>
    <a
      href="/history"
      class="nav-link"
    >
      <i class="fas fa-history mr-2.5 text-zinc-400 w-4 text-center"></i>History
    </a>
    <a
      href="/scan"
      class="nav-link"
    >
      <i class="fas fa-qrcode mr-2.5 text-zinc-400 w-4 text-center"></i>Connect Bot
    </a>
  </nav>
  <div class="border-t border-zinc-200 p-4">
    <button
      onclick="logout()"
      class="w-full flex items-center justify-center rounded-md bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-50 transition-colors hover:bg-zinc-900/90 shadow"
    >
      <i class="fas fa-sign-out-alt mr-2 text-zinc-300"></i>Logout
    </button>
  </div>
</aside>

