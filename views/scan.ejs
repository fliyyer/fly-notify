<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/app-head', {
        title: 'Manage WhatsApp Devices - FlyNotify',
        description: 'Kelola dan hubungkan beberapa device WhatsApp agar gateway siap menerima push notification.'
    }) %>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        h1, h2, h3 { font-family: 'Inter', sans-serif; }
        /* Modal styling */
        .modal { display: none; position: fixed; inset: 0; z-index: 100; background: rgba(9, 9, 11, 0.4); backdrop-filter: blur(4px); align-items: center; justify-content: center; }
        .modal.open { display: flex; }
    </style>
</head>
<body class="bg-zinc-50/50 text-zinc-900 antialiased min-h-screen">
    <%- include('partials/auth-guard') %>
    <div class="flex min-h-screen overflow-hidden">
        <%- include('partials/sidebar') %>
        <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <!-- Header -->
            <header class="border-b border-zinc-200 bg-white px-6 py-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center gap-3">
                        <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-950 hover:bg-zinc-50 lg:hidden" onclick="openSidebar()" aria-label="Open menu">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div>
                            <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">WhatsApp Devices</h2>
                            <p class="text-xs text-zinc-500 mt-1">Kelola beberapa nomor WhatsApp yang terhubung secara bersamaan.</p>
                        </div>
                    </div>
                    <div>
                        <button onclick="openAddDeviceModal()" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90 gap-1.5">
                            <i class="fas fa-plus text-xs"></i> Add WhatsApp Device
                        </button>
                    </div>
                </div>
            </header>
            
            <main class="flex-1 overflow-y-auto p-6">
                <!-- Skeleton Loader -->
                <div id="loader" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                    <div class="animate-pulse rounded-lg border border-zinc-200 bg-white p-6 h-64 shadow-sm"></div>
                    <div class="animate-pulse rounded-lg border border-zinc-200 bg-white p-6 h-64 shadow-sm"></div>
                    <div class="animate-pulse rounded-lg border border-zinc-200 bg-white p-6 h-64 shadow-sm"></div>
                </div>

                <!-- Devices Grid -->
                <div id="devicesGrid" class="hidden grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"></div>

                <!-- Empty State -->
                <div id="emptyState" class="hidden text-center py-16 px-4">
                    <div class="mx-auto w-12 h-12 rounded-md bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-550 mb-4 shadow-sm">
                        <i class="fas fa-qrcode text-xl"></i>
                    </div>
                    <h3 class="text-lg font-bold text-zinc-900">Belum ada device terdaftar</h3>
                    <p class="mt-1 text-xs text-zinc-500 max-w-xs mx-auto">Tambahkan device WhatsApp untuk mulai mengirimkan pesan gateway.</p>
                    <button onclick="openAddDeviceModal()" class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90 gap-1.5">
                        <i class="fas fa-plus text-xs"></i> Tambah Device Pertama
                    </button>
                </div>
            </main>
        </div>
    </div>

    <!-- Add Device Modal -->
    <div id="addDeviceModal" class="modal px-4">
        <div class="bg-white rounded-lg max-w-md w-full p-6 shadow-lg border border-zinc-200 relative">
            <button onclick="closeAddDeviceModal()" class="absolute top-4 right-4 text-zinc-400 hover:text-zinc-650 transition-colors">
                <i class="fas fa-times text-sm"></i>
            </button>
            <h3 class="text-lg font-bold text-zinc-900 mb-1">Register WhatsApp Device</h3>
            <p class="text-xs text-zinc-500 mb-6">Beri nama unik untuk device ini (misal: "Customer Service", "Billing Line").</p>
            
            <form id="addDeviceForm" onsubmit="handleAddDevice(event)" class="space-y-4">
                <div class="flex flex-col gap-1.5">
                    <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nama Device</label>
                    <input type="text" id="newDeviceName" required placeholder="Contoh: CS WhatsApp" class="field">
                </div>
                <div class="flex justify-end gap-2 pt-2 border-t border-zinc-100">
                    <button type="button" onclick="closeAddDeviceModal()" class="inline-flex h-9 items-center justify-center rounded-md border border-zinc-200 bg-white px-4 text-sm font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50">
                        Batal
                    </button>
                    <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90">
                        Simpan & Hubungkan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.querySelectorAll('.nav-link').forEach((link) => {
            if (link.href === window.location.href) link.classList.add('active');
        });

        function logout() {
            localStorage.removeItem('wa_token');
            window.location.href = '/login';
        }

        // Add Device Modal Control
        function openAddDeviceModal() {
            document.getElementById('addDeviceModal').classList.add('open');
            document.getElementById('newDeviceName').focus();
        }
        function closeAddDeviceModal() {
            document.getElementById('addDeviceModal').classList.remove('open');
            document.getElementById('newDeviceName').value = '';
        }

        // Fetch and Render Devices
        async function loadDevices() {
            try {
                const res = await fetch('/api/devices');
                const devices = await res.json();
                
                document.getElementById('loader').classList.add('hidden');
                
                const grid = document.getElementById('devicesGrid');
                const empty = document.getElementById('emptyState');
                
                if (devices.length === 0) {
                    grid.classList.add('hidden');
                    empty.classList.remove('hidden');
                    return;
                }
                
                empty.classList.add('hidden');
                grid.classList.remove('hidden');
                
                grid.innerHTML = devices.map(device => renderDeviceCard(device)).join('');
            } catch (err) {
                console.error('Failed to load devices:', err);
            }
        }

        function renderDeviceCard(device) {
            const status = device.status || { ready: false, hasQR: false, qr: null, error: null };
            let badgeClass = '';
            let badgeText = '';
            let contentHtml = '';
            let actionsHtml = '';

            if (status.ready) {
                badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-250';
                badgeText = 'CONNECTED';
                contentHtml = `
                    <div class="flex items-center gap-3 py-6">
                        <div class="w-10 h-10 rounded-md bg-emerald-55 text-emerald-600 flex items-center justify-center text-lg font-bold border border-emerald-100">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div>
                            <p class="font-bold text-sm text-zinc-900 leading-tight">${status.info?.name || 'WhatsApp Account'}</p>
                            <p class="text-xs text-zinc-500 mt-1">+${status.info?.number || '-'}</p>
                            <span class="inline-flex items-center gap-1 mt-1 text-[10px] text-zinc-400">
                                <i class="fas fa-mobile-alt"></i> platform: ${status.info?.platform || 'web'}
                            </span>
                        </div>
                    </div>
                `;
                actionsHtml = `
                    <button onclick="logoutDevice('${device.id}')" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50 flex-1">
                        <i class="fas fa-unlink mr-1.5 text-zinc-450"></i> Reset Session
                    </button>
                `;
            } else if (status.hasQR && status.qr) {
                badgeClass = 'bg-amber-50 text-amber-700 border-amber-250 animate-pulse';
                badgeText = 'SCAN QR NOW';
                contentHtml = `
                    <div class="flex flex-col items-center py-4">
                        <div class="relative bg-white border border-zinc-200 p-2 rounded-md shadow-sm">
                            <img src="${status.qr}" class="h-32 w-32 object-contain" alt="QR Code">
                        </div>
                        <p class="mt-3 text-[10px] text-zinc-450 text-center leading-normal">Tautkan perangkat dengan memindai kode QR dari WhatsApp HP Anda.</p>
                    </div>
                `;
                actionsHtml = `
                    <button onclick="logoutDevice('${device.id}')" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50 flex-1">
                        <i class="fas fa-rotate-right mr-1.5 text-zinc-450"></i> Refresh QR
                    </button>
                `;
            } else if (status.error) {
                badgeClass = 'bg-red-50 text-red-750 border-red-250';
                badgeText = 'ERROR';
                contentHtml = `
                    <div class="py-4">
                        <div class="rounded-md bg-red-50/50 p-3 border border-red-200 text-xs font-medium text-red-700 overflow-auto max-h-24 leading-normal">
                            <i class="fas fa-exclamation-triangle mr-1 text-red-500"></i> ${status.error}
                        </div>
                    </div>
                `;
                actionsHtml = `
                    <button onclick="logoutDevice('${device.id}')" class="inline-flex h-8 items-center justify-center rounded-md border border-zinc-200 bg-white px-3 text-xs font-medium text-zinc-700 shadow-sm transition-colors hover:bg-zinc-50 flex-1">
                        <i class="fas fa-rotate-right mr-1.5 text-zinc-450"></i> Coba Lagi
                    </button>
                `;
            } else {
                badgeClass = 'bg-zinc-50 text-zinc-700 border-zinc-250';
                badgeText = 'INITIALIZING';
                contentHtml = `
                    <div class="flex flex-col items-center justify-center py-8 text-zinc-400">
                        <i class="fas fa-circle-notch fa-spin text-2xl mb-2"></i>
                        <p class="text-xs font-semibold text-zinc-550">Memulai Puppeteer & WhatsApp...</p>
                    </div>
                `;
                actionsHtml = `
                    <button disabled class="inline-flex h-8 items-center justify-center rounded-md bg-zinc-50 border border-zinc-200 px-3 text-xs font-medium text-zinc-400 cursor-not-allowed flex-1">
                        Initializing...
                    </button>
                `;
            }

            const deleteBtn = `
                <button onclick="deleteDevice('${device.id}', '${device.name}')" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-red-200 bg-red-50 text-red-700 transition-colors hover:bg-red-100 hover:text-red-800" title="Delete Device">
                    <i class="fas fa-trash-alt text-xs"></i>
                </button>
            `;

            return `
                <div class="bg-white border border-zinc-200 rounded-lg p-5 flex flex-col justify-between min-h-[280px] shadow-sm">
                    <div>
                        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
                            <h3 class="font-bold text-sm text-zinc-900 truncate pr-2">${device.name}</h3>
                            <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-[10px] font-semibold ${badgeClass}">${badgeText}</span>
                        </div>
                        ${contentHtml}
                    </div>
                    <div class="flex gap-2 pt-3 border-t border-zinc-100">
                        ${actionsHtml}
                        ${deleteBtn}
                    </div>
                </div>
            `;
        }

        // Add Device
        async function handleAddDevice(e) {
            e.preventDefault();
            const name = document.getElementById('newDeviceName').value.trim();
            if (!name) return;

            try {
                const res = await fetch('/api/devices', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                const data = await res.json();
                if (data.success) {
                    closeAddDeviceModal();
                    loadDevices();
                } else {
                    alert(data.error || 'Gagal menambahkan device');
                }
            } catch (err) {
                alert('Koneksi bermasalah: ' + err.message);
            }
        }

        // Reset Session
        async function logoutDevice(id) {
            try {
                await fetch(`/api/devices/${id}/logout`, { method: 'POST' });
                loadDevices();
            } catch (err) {
                console.error('Failed to logout device:', err);
            }
        }

        // Delete Device
        async function deleteDevice(id, name) {
            if (!confirm(`Apakah Anda yakin ingin menghapus device "${name}"?\nSemua session auth untuk device ini akan dihapus secara permanen.`)) return;

            try {
                const res = await fetch(`/api/devices/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    loadDevices();
                } else {
                    alert(data.error || 'Gagal menghapus device');
                }
            } catch (err) {
                console.error('Failed to delete device:', err);
            }
        }

        // Socket IO configuration
        const socket = io();
        socket.on('devices_status', (statuses) => {
            loadDevices();
        });
        socket.on('device_status', (data) => {
            loadDevices();
        });

        // Init
        loadDevices();
    </script>
    <%- include('partials/app-shell-script') %>
</body>
</html>
