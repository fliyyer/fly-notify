<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/app-head', {
        title: 'Templates - FlyNotify',
        description: 'Kelola template pesan WhatsApp reusable untuk FlyNotify.'
    }) %>
    <style>
        h1, h2, h3 { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-zinc-50/50 text-zinc-900 antialiased min-h-screen">
    <%- include('partials/auth-guard') %>
    <div class="flex min-h-screen overflow-hidden">
        <%- include('partials/sidebar') %>
        <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            <!-- Header -->
            <header class="border-b border-zinc-200 bg-white px-6 py-5">
                <div class="flex items-center gap-3">
                    <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 hover:text-zinc-950 hover:bg-zinc-50 lg:hidden" onclick="openSidebar()" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl">Template Library</h2>
                        <p class="text-xs text-zinc-500 mt-1">Simpan template generik untuk dashboard atau API.</p>
                    </div>
                </div>
            </header>
            
            <main class="flex-1 overflow-y-auto p-6">
                <div class="grid grid-cols-1 gap-6 xl:grid-cols-[0.9fr_1.1fr]">
                    <!-- Left: Create Form -->
                    <section class="card p-6">
                        <h3 class="text-base font-bold text-zinc-900 mb-4">Template Baru</h3>
                        <form id="templateForm" class="space-y-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Nama Template</label>
                                <input id="templateName" required placeholder="Contoh: Reminder Invoice, OTP Auth" class="field">
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Isi Pesan</label>
                                <textarea id="templateMessage" required rows="10" placeholder="Tulis pesan template di sini..." class="field"></textarea>
                            </div>
                            <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90">
                                Simpan Template
                            </button>
                        </form>
                    </section>
                    
                    <!-- Right: Templates List -->
                    <section class="card p-6">
                        <h3 class="text-base font-bold text-zinc-900 border-b border-zinc-100 pb-3 mb-4">Saved Templates</h3>
                        <div id="templateList" class="space-y-4"></div>
                    </section>
                </div>
            </main>
        </div>
    </div>

    <script>
        function logout() {
            localStorage.removeItem('wa_token');
            window.location.href = '/login';
        }
        document.querySelectorAll('.nav-link').forEach((link) => {
            if (link.href === window.location.href) link.classList.add('active');
        });
        async function loadTemplates() {
            const res = await fetch('/api/templates');
            const templates = await res.json();
            const container = document.getElementById('templateList');
            if (templates.length === 0) {
                container.innerHTML = '<div class="rounded-md border border-zinc-200 bg-zinc-50 p-4 text-xs font-medium text-zinc-500">Belum ada template terdaftar.</div>';
                return;
            }
            container.innerHTML = templates.map((item) => `
                <div class="rounded-lg border border-zinc-200 bg-white p-4 shadow-sm">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-bold text-zinc-900">${item.name}</p>
                            <pre class="mt-2.5 whitespace-pre-wrap text-xs text-zinc-500 font-mono bg-zinc-50 border border-zinc-150 p-3 rounded-md leading-relaxed">${item.message}</pre>
                        </div>
                        <button onclick="deleteTemplate(${item.id})" class="inline-flex h-8 items-center justify-center rounded-md border border-red-200 bg-red-50 px-3 text-xs font-medium text-red-750 transition-colors hover:bg-red-100 flex-shrink-0">
                            Delete
                        </button>
                    </div>
                </div>
            `).join('');
        }
        async function deleteTemplate(id) {
            if (!confirm('Apakah Anda yakin ingin menghapus template ini?')) return;
            await fetch('/api/templates/' + id, { method: 'DELETE' });
            loadTemplates();
        }
        document.getElementById('templateForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            await fetch('/api/templates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: document.getElementById('templateName').value.trim(),
                    message: document.getElementById('templateMessage').value.trim()
                })
            });
            document.getElementById('templateForm').reset();
            loadTemplates();
        });
        loadTemplates();
    </script>
    <%- include('partials/app-shell-script') %>
</body>
</html>
